# 复制为 .env 后按需修改（docker compose 会自动读取）
# 也可直接 export 后运行：NODE_USE_ENV_PROXY=1 node src/server.js

# 服务端口
PORT=8787

# 访问令牌：设置后所有 /api 请求需携带 x-access-token 头或 ?token= 参数
# 公网部署强烈建议设置；留空表示无需鉴权
ACCESS_TOKEN=

# 每日市场日报：生成时间（Asia/Shanghai）与是否仅工作日（0=每天，1=仅周一至周五）
REPORT_TIME=08:30
REPORT_WEEKDAYS_ONLY=1

# 飞书 / Lark 自定义群机器人 Webhook（可选，配置后日报自动推送）
LARK_WEBHOOK=
FEISHU_WEBHOOK=

# ===== 大模型（可选，任选一组即可增强解读；不配置则使用内置规则引擎）=====
# 1) 通用 OpenAI 兼容接口（火山方舟、DeepSeek、Moonshot 等均可）
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=

# 2) 火山方舟专用
ARK_API_KEY=
ARK_MODEL=

# 3) OpenAI 官方
OPENAI_API_KEY=

# ===== 网络 =====
# 服务器无法直连外网时必须配置代理，Node 20+ 需 NODE_USE_ENV_PROXY=1
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
HTTPS_PROXY=
